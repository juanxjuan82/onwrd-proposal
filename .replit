modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "crawl4ai"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-build"

[[workflows.workflow]]
name = "crawl4ai"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --import tsx/esm --test src/crawlers/crawl4ai-client.test.ts src/crawlers/crawler-sources.test.ts src/crawlers/crawl4ai-migration.test.ts"

[[workflows.workflow]]
name = "api-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/api-server build"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-docs:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NOTIFICATION_EMAIL = "j.aymes@onwrdadvisors.com"
SMTP_USER = "john.aymes@gmail.com"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
RESEND_FROM = "ONWRD Tender Desk <desk@onwrdadvisors.com>"
GITHUB_REPO = "https://github.com/juanxjuan82/onwrd-proposal"
PROPOSAL_NOTIFY_EMAIL = "j.aymes@onwrdadvisors.com"

[userenv.production]
GOOGLE_OAUTH_CALLBACK_URL = "https://proposals.onwrdadvisors.com/api/auth/google/callback"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 25931
externalPort = 3000

[[ports]]
localPort = 25932
externalPort = 3001
