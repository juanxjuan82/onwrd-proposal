modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-docs:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NOTIFICATION_EMAIL = "j.aymes@onwrdadvisors.com"
SMTP_USER = "john.aymes@gmail.com"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
RESEND_FROM = "ONWRD Tender Desk <desk@onwrdadvisors.com>"
GITHUB_REPO = "https://github.com/juanxjuan82/onwrd-proposal"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 25931
externalPort = 3000

[[ports]]
localPort = 25932
externalPort = 3001
